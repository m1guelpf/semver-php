{
    "name": "semver-php/benchmarks",
    "description": "Benchmarks for composer/semver",
    "type": "project",
    "require": {
        "php": "^8.1",
        "composer/semver": "^3.4"
    },
    "require-dev": {
        "phpbench/phpbench": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "SemverBench\\": "php"
        }
    },
    "config": {
        "allow-plugins": {
            "phpbench/phpbench": true
        }
    }
}
